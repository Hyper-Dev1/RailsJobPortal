<h2>Manage Jobs</h2>
<%= link_to 'Post a New Job', new_admin_job_path, class: 'btn btn-primary mb-3' %>
<table class="table table-striped table-bordered">
  <thead class="table-dark">
    <tr>
      <th>Title</th>
      <th>Company</th>
      <th>Location</th>
      <th>Job Type</th>
      <th>Salary</th>
      <th>Posted Date</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @jobs.each do |job| %>
      <tr>
        <td><%= job.title %></td>
        <td><%= job.company.name %></td>
        <td><%= job.location %></td>
        <td><%= job.timeStatus %></td>
        <td><%= job.salary %></td>
        <td><%= time_ago_in_words(job.created_at) %> ago</td>
        <td>
          <%= link_to 'Edit', edit_admin_job_path(job), class: 'btn btn-warning btn-sm' %>
          <%= link_to 'Delete', admin_job_path(job), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
