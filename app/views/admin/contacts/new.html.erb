<h2>New Contact</h2>
<%= form_with model: @contact, url: admin_contacts_path, local: true do |f| %>
  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, class: 'form-control' %>
  </div>
  <div class="form-group">
    <%= f.label :email %>
    <%= f.text_field :email, class: 'form-control' %>
  </div>
  <div class="form-group">
    <%= f.label :subject %>
    <%= f.text_field :subject, class: 'form-control' %>
  </div>
  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_area :description, class: 'form-control' %>
  </div>
  <%= f.submit 'Create Contact', class: 'btn btn-success' %>
<% end %>
<%= link_to 'Back', admin_contacts_path, class: 'btn btn-secondary mt-3' %>
