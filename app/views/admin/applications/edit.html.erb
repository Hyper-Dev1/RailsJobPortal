<h2>Edit Application</h2>
<%= form_with model: @application, local: true do |f| %>
  <div class="form-group">
    <%= f.label :status %>
    <%= f.text_field :status, class: 'form-control' %>
  </div>
  <div class="form-group">
    <%= f.label :job_id %>
    <%= f.collection_select :job_id, Job.all, :id, :title, { include_blank: true }, class: 'form-control' %>
  </div>
  <div class="form-group">
    <%= f.label :company_id %>
    <%= f.collection_select :company_id, Company.all, :id, :name, { include_blank: true }, class: 'form-control' %>
  </div>
  <%= f.submit 'Update Application', class: 'btn btn-warning' %>
<% end %>
<%= link_to 'Back', admin_applications_path, class: 'btn btn-secondary mt-3' %>
